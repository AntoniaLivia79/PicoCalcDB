CASE "="        : z_lo% = IxBound%(SxV$(), SxN%, z_k$, 0) : z_hi% = IxBound%(SxV$(), SxN%, z_k$, 1)
CASE ">", ">="  : z_lo% = IxBound%(SxV$(), SxN%, z_k$, 0)
CASE "<", "<="  : z_hi% = IxBound%(SxV$(), SxN%, z_k$, 1)
CASE "LIKE"
z_k$ = SxEnc$(z_s%, z_v$, 1)
