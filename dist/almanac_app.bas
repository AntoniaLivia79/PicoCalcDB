DO WHILE NOT EOF(#z_fnum%)
z_off% = LOC(#z_fnum%)
z_r$ = IxLine$(z_fnum%)
IF IxLong% THEN
INC IxBad% : z_frag% = 1
ELSEIF z_frag% THEN
z_frag% = 0
ELSEIF RcCheck%(z_r$) < 0 THEN
IF LEN(z_r$) > 0 THEN INC IxBad%
ELSE
z_id$ = RcGet$(z_r$, "_id")
IF RcFound% AND LEN(z_id$) > 0 AND LEN(z_id$) <= IX_KLEN THEN
IF IxN% >= IX_MAX THEN IxCompact
IF IxN% >= IX_MAX THEN IxErr$ = "index full" : EXIT FUNCTION
IxK$(IxN%) = z_id$
IxO%(IxN%) = z_off%
IF INSTR(z_r$, CHR$(34) + "_del" + CHR$(34)) THEN
z_id$ = RcGet$(z_r$, "_del")
IF RcFound% AND z_id$ <> "0" AND z_id$ <> "false" THEN IxO%(IxN%) = -z_off%
ENDIF
INC IxN%
ELSE
INC IxBad%
ENDIF
