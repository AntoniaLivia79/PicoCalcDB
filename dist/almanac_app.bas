IF IxKeyOk%(z_id$) = 0 THEN EXIT FUNCTION
z_oo% = IxGet%(z_id$)
IF z_oo% > 0 AND z_old$ <> "" THEN
FOR z_s% = 0 TO SX_SLOTS - 1
IF SxF$(z_s%) <> "" THEN
z_v$ = RcGet$(z_old$, SxF$(z_s%)) : z_ft% = RcT%
IF RcFound% THEN z_v$ = STR$(SxRemoveK%(SxEnc$(z_s%, z_v$, z_ft%), z_oo%))
ENDIF
NEXT
ENDIF
IF INSTR(z_rec$, CHR$(34) + "_del" + CHR$(34)) THEN
z_v$ = RcGet$(z_rec$, "_del")
IF RcFound% AND z_v$ <> "0" AND z_v$ <> "false" THEN z_v$ = STR$(IxRemove%(z_id$)) : IxApply% = 1 : EXIT FUNCTION
ENDIF
IF IxPut%(z_id$, z_off%) = 0 THEN EXIT FUNCTION
FOR z_s% = 0 TO SX_SLOTS - 1
IF SxF$(z_s%) <> "" THEN
z_v$ = RcGet$(z_rec$, SxF$(z_s%)) : z_ft% = RcT%
IF RcFound% THEN
IF SxAddK%(SxEnc$(z_s%, z_v$, z_ft%), z_off%) = 0 THEN EXIT FUNCTION
ENDIF
ENDIF
NEXT
IxApply% = 1
END FUNCTION
FUNCTION IxLine$(z_fnum%)
LOCAL z_r$ = CHR$(1)
IxLong% = 0
ON ERROR SKIP 1
LINE INPUT #z_fnum%, z_r$
IF z_r$ = CHR$(1) THEN IxLong% = 1
IxLine$ = z_r$
END FUNCTION
FUNCTION IxReadAt$(z_fnum%, z_off%)
LOCAL z_r$ = CHR$(1)
SEEK #z_fnum%, z_off%
ON ERROR SKIP 1
LINE INPUT #z_fnum%, z_r$
IF z_r$ = CHR$(1) THEN z_r$ = ""
IxReadAt$ = z_r$
END FUNCTION
SUB IxCompact
LOCAL z_ix%(IX_MAX - 1), z_tmp%(IX_MAX - 1), z_i%, z_j%, z_w%, z_b%
IF IxN% = 0 THEN EXIT SUB
SORT IxK$(), z_ix%(), , 0, IxN%
FOR z_i% = 0 TO IxN% - 1 : z_tmp%(z_i%) = IxO%(z_ix%(z_i%)) : NEXT
z_i% = 0 : z_w% = 0
DO WHILE z_i% < IxN%
z_j% = z_i% : z_b% = z_tmp%(z_i%)
DO WHILE z_j% + 1 < IxN%
IF IxK$(z_j% + 1) <> IxK$(z_i%) THEN EXIT DO
INC z_j%
IF ABS(z_tmp%(z_j%)) > ABS(z_b%) THEN z_b% = z_tmp%(z_j%)
LOOP
IF z_b% > 0 THEN IxK$(z_w%) = IxK$(z_i%) : IxO%(z_w%) = z_b% : INC z_w%
z_i% = z_j% + 1
LOOP
IxN% = z_w%
END SUB
FUNCTION IxScan%(z_fnum%, z_from%)
